# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=./data/vista.db

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Matterport (Backend only — NEVER expose to frontend)
MATTERPORT_API_KEY=your-matterport-api-key

# CORS (comma-separated, include both API and frontend origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Dev route protection — set a strong random string when deploying publicly
# Frontend must send this as x-dev-secret header (VITE_DEV_SECRET)
DEV_SECRET=
