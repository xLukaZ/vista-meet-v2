{
  "name": "@meet-vista/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env dist/db/migrate.js"
  },
  "dependencies": {
    "@meet-vista/core": "workspace:*",
    "hono": "^4.6.3",
    "@hono/node-server": "^1.13.2",
    "@hono/zod-validator": "^0.4.1",
    "drizzle-orm": "^0.33.0",
    "@libsql/client": "^0.14.0",
    "jose": "^5.9.6",
    "@node-rs/argon2": "^1.7.2",
    "zod": "^3.23.8",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "hono-rate-limiter": "^0.4.0",
    "livekit-server-sdk": "^2.7.1"
  },
  "devDependencies": {
    "@meet-vista/config": "workspace:*",
    "typescript": "^5.4.5",
    "drizzle-kit": "^0.24.2",
    "vitest": "^1.6.0"
  }
}
